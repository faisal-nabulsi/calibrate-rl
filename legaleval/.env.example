# Copy to .env and fill in. .env is gitignored — never commit keys.
#
# Five models under test (incognito generation) + the grader.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
QWEN_API_KEY=
MUSE_API_KEY=
# Key usage:
#   ANTHROPIC_API_KEY  -> Claude Sonnet 4.6 (under test) + Opus 4.8 grader
#   OPENAI_API_KEY     -> GPT 5.5 (under test) + optional cross-family grader
#   GEMINI_API_KEY     -> Gemini 3.1 Pro
#   QWEN_API_KEY       -> Qwen 3.7 Plus  (Alibaba DashScope, OpenAI-compatible)
#   MUSE_API_KEY       -> Muse Spark / Meta AI  (Llama API, OpenAI-compatible)
#
# Optional — exact model strings / endpoints. Defaults shown; uncomment to override.
# OPENAI_MODEL=gpt-5.5
# GEMINI_MODEL=gemini-3.1-pro   (set =gemini-3.1-flash to fall back if rate-limited)
# QWEN_MODEL=qwen-plus
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# MUSE_MODEL=muse-spark
# MUSE_BASE_URL=https://api.llama.com/compat/v1
